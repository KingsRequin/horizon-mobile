<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : rien n'est sauvegardé ni transféré vers un autre téléphone (le jeton
     d'appairage vaut pour ce téléphone-ci ; un nouveau téléphone s'appaire à son tour). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
